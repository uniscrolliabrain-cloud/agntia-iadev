{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceTurn",
  "type": "object",
  "required": [
    "id",
    "role",
    "content",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "user",
        "assistant"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "line_start",
        "line_end"
      ]
    }
  }
}
