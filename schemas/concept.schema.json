{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeConcept",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_spans",
    "status",
    "curriculum_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^concept-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "prompt_origin_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "curriculum_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taxonomy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "stub",
        "extracted",
        "reviewed",
        "verified"
      ]
    },
    "visibility": {
      "enum": [
        "internal",
        "public_reviewed"
      ]
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "line_start",
        "line_end"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
